{
    "name": "spinotek/certificate-sandbox",
    "description": "Aplikasi Laravel 12 untuk mencoba package sertifikat lokal.",
    "type": "project",
    "license": "MIT",
    "repositories": [
        {
            "type": "path",
            "url": "..",
            "options": { "symlink": true, "versions": { "spinotek/certificate-generator": "dev-main" } }
        }
    ],
    "require": {
        "laravel/framework": "^12.0",
        "spinotek/certificate-generator": "dev-main"
    },
    "require-dev": {
        "khanamiryan/qrcode-detector-decoder": "^2.0.2",
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": { "App\\": "app/" }
    },
    "scripts": {
        "post-autoload-dump": ["@php artisan package:discover --ansi"],
        "test": "phpunit --configuration ../phpunit.xml"
    },
    "config": {
        "platform": {
            "php": "8.2.30"
        }
    }
}
