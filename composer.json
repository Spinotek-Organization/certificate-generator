{
    "name": "spinotek/certificate-generator",
    "description": "Penerbitan PDF sertifikat dan verifikasi QR untuk Laravel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "endroid/qr-code": "^6.0",
        "laravel/framework": "^12.0",
        "dompdf/dompdf": "^3.1.6"
    },
    "autoload": {
        "psr-4": { "Spinotek\\CertificateGenerator\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Spinotek\\CertificateGenerator\\CertificateServiceProvider"]
        }
    },
    "archive": {
        "exclude": ["/sandbox", "/tests"]
    }
}
